# ============================================================
# FICHIER TEMPLATE - Copier en .env et remplir les valeurs
# Ce fichier .env.example PEUT être mis sur GitHub (pas de secrets)
# Le vrai .env NE DOIT PAS être sur GitHub
# ============================================================

# Secret Key pour Dash (générer une clé aléatoire)
SECRET_KEY=your_secret_key_here

# Environnement : development ou production
FLASK_ENV=production

# Port (Render le gère automatiquement)
PORT=8070

# Debug (toujours False en production)
DEBUG=False
